# cp .env.example .env 후 값을 채우세요. 토큰은 `openssl rand -hex 32` 로 만드세요.

POSTGRES_PASSWORD=change-this-db-password

# 웹 로그인 토큰
MAKEBOARD_ADMIN_TOKEN=

# 에이전트가 접속하고 설치 명령어에 들어갈 이 서버의 주소 (고정 IP 또는 도메인)
MAKEBOARD_PUBLIC_URL=http://<이 서버 IP>:8000

# (선택) 웹이 아니라 .env 로 직접 등록할 에이전트. 서버이름:토큰 을 쉼표로 구분.
# 보통은 비워 두고 웹의 "+ 서버 추가"를 쓴다
MAKEBOARD_AGENT_TOKENS=

# HTTPS 뒤에서 운영하면 true (세션 쿠키에 Secure 속성)
MAKEBOARD_COOKIE_SECURE=false

MAKEBOARD_PORT=8000
